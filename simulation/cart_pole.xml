<mujoco model = "cart_pole">
    <compiler angle="radian"/>
    <option timestep="0.02" gravity="0 0 -9.81" integrator="implicitfast"/>
    <default>
        <joint damping="0.02" frictionloss="0.001"/>
        <geom condim="3" friction="1.0 0.005 0.0001"/>
    </default>
    <worldbody>
        <light pos="0 0 4" dir="0 0 -1"/>
        <!-- Ground -->
        <geom name="ground" type="plane" size="0 0 0.1" rgba="0.8 0.9 0.8 1"/>
        <!-- Track -->
        <geom name="track" type="box" size="2.5 0.3 1" pos="0 0 0" rgba="0.5 0.5 0.5 1" contype="0" conaffinity="0"/>
        <!-- Cart -->
        <body name="cart" pos="0 0 1.15">
            <geom name="cart_body" type="box" size="0.2 0.35 0.15" pos="0 0 0" rgba="0.8 0.2 0.2 1" mass="0.5"/>
            <joint name="cart_joint" type="slide" axis="1 0 0"/> 
            <! -- limited="true" range="-2.3 2.3 is temporarily removed because of continuity problem--/>
            <!-- Pendulum -->
            <body name="pendulum" pos="0 -0.375 0.0">
                <joint name="pendulum_joint"
                       type="hinge"
                       axis="0 1 0"
                       damping="0.002"
                       frictionloss="0"/>
                <geom name="pendulum_rod"
                      type="capsule"
                      fromto="0 0 0 0 0 -0.8"
                      size="0.025"
                      mass="0.5"
                      rgba="0.1 0.3 0.9 1"/>
                <geom name="pendulum_tip"
                      type="sphere"
                      pos="0 0 -0.8"
                      size="0.06"
                      mass="0.1"
                      rgba="0.9 0.2 0.1 1"/>
            </body>
        </body>
    </worldbody>
    <!-- Cart Actuator connected to the linear joint. Default control range is 50 Nm. Can be changed later with a config file. -->
    <actuator>
        <motor name="cart_motor"
               joint="cart_joint"
               gear="1"
               ctrllimited="true"
               ctrlrange="-50 50"/>
    </actuator>
</mujoco>